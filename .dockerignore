*.orig
*.rej
*.tmp
*.log
dump.rdb
*.sql
*.sqlite
*.sqlite3
*.sqlite3-journal

# ───── 大型 binary / archive (間違い混入防止) ─────
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
